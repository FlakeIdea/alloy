+/* Hands a request the source has accepted to the stream's own queue to wait for its sample. */
+static HRESULT queue_sample_wait(struct media_source *source, struct media_stream *stream, IUnknown *token)
+{
+    struct source_async_command *command;
+    IUnknown *op;
+    HRESULT hr;
+
+    if (FAILED(hr = source_create_async_op(SOURCE_ASYNC_WAIT_SAMPLE, &op)))
+        return hr;
+
+    command = impl_from_async_command_IUnknown(op);
+    IMFMediaStream_AddRef(&stream->IMFMediaStream_iface);
+    command->u.request_sample.stream = stream;
+    if (token)
+        IUnknown_AddRef(token);
+    command->u.request_sample.token = token;
+
+    hr = MFPutWorkItem(stream->sample_queue, &source->async_commands_callback, op);
+    IUnknown_Release(op);
+    return hr;
+}
+
 static HRESULT WINAPI source_async_commands_Invoke(IMFAsyncCallback *iface, IMFAsyncResult *result)
 {
     struct media_source *source = impl_from_async_commands_callback_IMFAsyncCallback(iface);
