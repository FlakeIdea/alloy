--- a/programs/wineboot/wineboot.c
+++ b/programs/wineboot/wineboot.c
@@ -233,6 +233,19 @@
         return 0;
     }
 
+    /* Under Apple's Rosetta 2 the time stamp counter counts nanoseconds, so its frequency (1000 MHz) says nothing
+     * about the processor. Returning 0 makes the caller use the speed from the power information instead. */
+    __cpuid( regs, 0x80000000 );
+    if (regs[0] >= 0x80000002)
+    {
+        __cpuid( regs, 0x80000002 );
+        if (!memcmp( regs, "VirtualApple", 12 ))
+        {
+            WARN( "Not computing TSC frequency under Rosetta 2.\n" );
+            return 0;
+        }
+    }
