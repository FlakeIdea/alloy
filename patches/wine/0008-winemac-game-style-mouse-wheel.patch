--- a/dlls/winemac.drv/cocoa_app.m
+++ b/dlls/winemac.drv/cocoa_app.m
@@ -1806,6 +1806,35 @@
                 process = NSMouseInRect(nspoint, contentRect, NO);
             }
 
+            /* Alloy: while a game holds the cursor (clipped or hidden, as in mouse-look), scrolling behaves like a
+               Windows mouse wheel: one WHEEL_DELTA per wheel click, no inertia after a trackpad or Magic Mouse
+               swipe, nothing for a finger resting on them, and the cursor stays where the game put it. */
+            BOOL game = self.clippingCursor || clientWantsCursorHidden;
+            BOOL gesture = [theEvent phase] != NSEventPhaseNone || [theEvent momentumPhase] != NSEventPhaseNone;
+            int gameWheelX = 0, gameWheelY = 0;
+
+            if (process && game)
+            {
+                if ([theEvent momentumPhase] != NSEventPhaseNone)
+                    process = FALSE;
+                else if (gesture)
+                {
+                    if ([theEvent phase] & (NSEventPhaseMayBegin | NSEventPhaseBegan | NSEventPhaseEnded | NSEventPhaseCancelled))
+                        gameScrollX = gameScrollY = 0;
+                }
+                else
+                {
+                    /* A mouse wheel. macOS smooths each click (or each accelerated group of clicks) into a burst
+                       of up to about 20 events, all with the click's timestamp; only the first one counts. */
+                    gameWheelX = [theEvent deltaX] < 0 ? 120 : [theEvent deltaX] > 0 ? -120 : 0;
+                    gameWheelY = [theEvent deltaY] > 0 ? 120 : [theEvent deltaY] < 0 ? -120 : 0;
+                    if ((!gameWheelX && !gameWheelY) || [theEvent timestamp] == lastGameWheelTime)
+                        process = FALSE;
+                    else
+                        lastGameWheelTime = [theEvent timestamp];
+                }
+            }
+
             if (process)
             {
                 macdrv_event* event;
@@ -1857,8 +1886,30 @@
                 x *= 6;
                 y *= 6;
 
-                if (use_precise_scrolling)
+                if (game)
                 {
+                    event->mouse_scroll.keep_cursor = 1;
+                    if (!gesture)
+                    {
+                        event->mouse_scroll.x_scroll = gameWheelX;
+                        event->mouse_scroll.y_scroll = gameWheelY;
+                    }
+                    else
+                    {
+                        /* A trackpad or Magic Mouse swipe gives one WHEEL_DELTA per 20 points, so resting or
+                           brushing a finger on it doesn't scroll. Reversing direction starts over. */
+                        if ((gameScrollX < 0 && x > 0) || (gameScrollX > 0 && x < 0)) gameScrollX = 0;
+                        if ((gameScrollY < 0 && y > 0) || (gameScrollY > 0 && y < 0)) gameScrollY = 0;
+                        gameScrollX += x;
+                        gameScrollY += y;
+                        event->mouse_scroll.x_scroll = 120 * (int)trunc(gameScrollX / 120);
+                        event->mouse_scroll.y_scroll = 120 * (int)trunc(gameScrollY / 120);
+                        gameScrollX -= event->mouse_scroll.x_scroll;
+                        gameScrollY -= event->mouse_scroll.y_scroll;
+                    }
+                }
+                else if (use_precise_scrolling)
+                {
                     event->mouse_scroll.x_scroll = x;
                     event->mouse_scroll.y_scroll = y;
 
@@ -1927,7 +1978,9 @@
                 // Since scroll wheel events deliver absolute cursor position, the
                 // accumulating delta from move events is invalidated.  Make sure next
                 // mouse move event starts over from an absolute baseline.
-                forceNextMouseMoveAbsolute = TRUE;
+                // Alloy: in a game the scroll doesn't move the cursor, so mouse movement stays relative.
+                if (!game)
+                    forceNextMouseMoveAbsolute = TRUE;
             }
         }
     }
