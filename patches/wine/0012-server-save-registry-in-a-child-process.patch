+#ifdef __APPLE__
+
+/* Saving a branch rewrites its whole file, and the server answers no request while it does: every 30 seconds each
+ * program in the prefix stops for as long as that takes (27 ms for a 3 MB system.reg under Rosetta 2, and a prefix
+ * with Steam in it grows past 10 MB). The periodic save is done by a forked child instead, which writes the registry
+ * as it was at the fork while the server goes on. The server marks the branches clean at the fork, so changes made
+ * during the save are written by the next one, and marks them dirty again if the child fails. */
+
+static pid_t save_child;                  /* child process writing the registry, 0 if none */
+static unsigned int save_child_branches;  /* bit mask of the branches it is writing */
+
+/* the save child has ended */
+static void save_child_done( int failed )
+{
+    int i;
+
+    for (i = 0; failed && i < save_branch_count; i++)
+        if (save_child_branches & (1u << i)) save_branch_info[i].key->flags |= KEY_DIRTY;
+    save_child = 0;
+    save_child_branches = 0;
+}
+
+/* collect the save child if it has ended (SIGCHLD) */
+void reap_registry_save(void)
+{
+    int status;
+    pid_t ret;
+
+    if (!save_child) return;
+    ret = waitpid( save_child, &status, WNOHANG );
+    if (ret == save_child) save_child_done( !WIFEXITED(status) || WEXITSTATUS(status) );
+    else if (ret == -1 && errno != EINTR) save_child_done( 1 );
+}
+
+/* wait for the save child, so that a save that follows cannot be overwritten by its older copy */
+static void wait_registry_save( int kill_it )
+{
+    int status;
+    pid_t ret;
+
+    reap_registry_save();  /* it may have ended already */
+    if (!save_child) return;
+    if (kill_it) kill( save_child, SIGKILL );
+    while ((ret = waitpid( save_child, &status, 0 )) == -1 && errno == EINTR) /* nothing */;
+    save_child_done( kill_it || ret != save_child || !WIFEXITED(status) || WEXITSTATUS(status) );
+}
+
+/* start saving the dirty branches in a child process; returns 0 if it could not be started */
+static int save_in_background(void)
+{
+    static const int signals[] = { SIGTERM, SIGINT, SIGHUP, SIGQUIT, SIGIO, SIGCHLD, SIGALRM };
+    unsigned int mask = 0;
+    pid_t pid;
+    int i;
+
+    for (i = 0; i < save_branch_count; i++)
+        if (save_branch_info[i].key->flags & KEY_DIRTY) mask |= 1u << i;
+    if (!mask) return 1;
+
+    if ((pid = fork()) == -1) return 0;
+    if (!pid)
+    {
+        int ok = 1;
+
+        /* the server's handlers write to pipes the child shares with it */
+        for (i = 0; i < ARRAY_SIZE(signals); i++) signal( signals[i], SIG_DFL );
+        for (i = 0; i < save_branch_count; i++)
+            if (mask & (1u << i)) ok &= save_branch( save_branch_info[i].key, save_branch_info[i].filename );
+        _exit( !ok );  /* not exit(): the server's exit handlers remove its socket */
+    }
+    save_child = pid;
+    save_child_branches = mask;
+    for (i = 0; i < save_branch_count; i++)
+        if (mask & (1u << i)) make_clean( save_branch_info[i].key );
+    return 1;
+}
+
+#endif  /* __APPLE__ */
+
