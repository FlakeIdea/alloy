  *
  * Handler for MOUSE_SCROLL events.
  */
+/* Alloy: one message per WHEEL_DELTA, as a Windows mouse sends for each click: many games count the messages,
+   not their size. */
+static void send_wheel_steps(HWND hwnd, const macdrv_event *event, UINT flags, int amount)
+{
+    int step = amount > 0 ? 120 : -120, count = min(abs(amount) / 120, 16);
+
+    while (count--)
+        send_mouse_input(hwnd, event->window, flags, event->mouse_scroll.x, event->mouse_scroll.y, step, FALSE,
+                         event->mouse_scroll.time_ms);
+}
