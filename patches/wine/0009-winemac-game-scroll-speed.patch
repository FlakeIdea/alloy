+/* Alloy: wheel steps for one wheel click at the game's scroll speed. The fraction carries over to the next click
+   in the same direction; starting at a half rounds to the nearest step, so at 50% the first click scrolls. */
+static int game_wheel_steps(double *acc, int *last_dir, int dir, BOOL restart)
+{
+    int steps;
+
+    if (!dir) return 0;
+    if (restart || dir != *last_dir) *acc = 0.5;
+    *last_dir = dir;
+    *acc += game_scroll_speed_percent / 100.0;
+    steps = (int)floor(*acc);
+    *acc -= steps;
+    return steps * dir * 120;
+}
