--- a/dlls/winemac.drv/cocoa_cursorclipping.h
+++ b/dlls/winemac.drv/cocoa_cursorclipping.h
@@ -41,6 +41,9 @@
      */
     - (BOOL) setCursorPosition:(CGPoint)pos;
 
+    /* Alloy: if provided, the region the cursor is actually held in, when that can be smaller than cursorClipRect. */
+    - (CGRect) effectiveClipRect;
+
 @end
 
 
--- a/dlls/winemac.drv/cocoa_cursorclipping.m
+++ b/dlls/winemac.drv/cocoa_cursorclipping.m
@@ -494,9 +494,26 @@
         return TRUE;
     }
 
+    /* Alloy: macOS confines the cursor to the part of the game's rect that lies in the window (see
+     * rectForScreenRect:inWindow:), which is smaller than cursorClipRect when a game clips to its whole monitor or to
+     * a rect a little larger than its window. Read back from the window, so it follows the window as it moves. */
+    - (CGRect) effectiveClipRect
+    {
+        NSWindow *window = [NSApp windowWithWindowNumber:clippingWindowNumber];
+        NSRect confined = window ? [window mouseConfinementRect] : NSZeroRect;
+        CGRect effective;
+
+        if (NSIsEmptyRect(confined))
+            return cursorClipRect;
+        confined = [window convertRectToScreen:confined];
+        [[WineApplicationController sharedController] flipRect:&confined];
+        effective = CGRectIntersection(cursorClipRect, NSRectToCGRect(confined));
+        return CGRectIsEmpty(effective) ? cursorClipRect : effective;
+    }
+
     - (void) clipCursorLocation:(CGPoint*)location
     {
-        clip_cursor_location(cursorClipRect, location);
+        clip_cursor_location([self effectiveClipRect], location);
     }
 
     - (void) setRetinaMode:(BOOL)mode
